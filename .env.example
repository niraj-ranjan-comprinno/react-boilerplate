# ──────────────────────────────────────────────────────────────────────────────
# Environment variables for react-boilerplate
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of your backend API (no trailing slash)
VITE_API_URL=http://localhost:4000/api

# Auth provider (if using a third-party OAuth service)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Feature flags (true / false)
VITE_ENABLE_VOICE_VERIFY=true
VITE_ENABLE_MFA=true

# Analytics (optional)
# VITE_POSTHOG_KEY=phc_xxxx
